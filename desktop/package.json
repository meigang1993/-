{
  "name": "succubus-kill-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Electron shell for the current approved HTML edition.",
  "main": "src/main.js",
  "scripts": {
    "check": "node scripts/check-desktop.js",
    "test": "node --test tests/*.test.js",
    "start": "electron-forge start",
    "package:win": "electron-forge package --platform=win32 --arch=x64",
    "make:win": "node scripts/make-win.mjs",
    "prepare:wormhole": "node scripts/prepare-wormhole.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "archiver": "8.0.0",
    "electron": "43.2.0"
  }
}
