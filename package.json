{
  "name": "game-2971485-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Local QA tools for the static game project.",
  "scripts": {
    "check": "node tools/run-qa.js prebrowser",
    "check:core": "node tools/run-qa.js core",
    "lint": "node tools/run-qa.js lint",
    "lint:js": "node tools/run-domain-lint.js original",
    "lint:css": "stylelint \"publish/**/*.css\"",
    "lint:html": "htmlhint \"publish/**/*.html\"",
    "qa": "npm run qa:full",
    "qa:quick": "node tools/run-qa.js quick",
    "qa:full": "npm run verify",
    "qa:exhaustive": "bash scripts/verify-exhaustive.sh",
    "hooks:install": "node tools/install-git-hooks.js",
    "check:hooks": "node tools/install-git-hooks.js --check",
    "qa:watch": "chokidar \"src/original/**/*.js\" \"publish/**/*.{js,css,html}\" \"tools/**/*.js\" \"tests/**/*.js\" \"eslint.config.js\" \"stylelint.config.cjs\" \".htmlhintrc\" \"playwright*.config.js\" -c \"npm run qa:quick\" --initial --debounce 800 --silent",
    "verify": "bash scripts/verify.sh",
    "test": "npm run qa:full",
    "save:checkpoint": "bash scripts/save-checkpoint.sh",
    "save:studio": "bash scripts/save.sh",
    "check:static": "node tools/check-static.js",
    "check:risks": "node tools/check-runtime-risks.js",
    "validate:data": "node tools/validate-data.js",
    "validate:relations": "node tools/validate-relations.js",
    "check:resources": "node tools/check-resources.js",
    "check:asset-budget": "node tools/check-asset-budget.js",
    "check:scripts": "node tools/check-script-contracts.js",
    "check:lines": "node tools/line-count.js",
    "check:all": "node tools/check-all.js",
    "check:performance": "node tools/check-startup-performance.js",
    "check:duplicates": "jscpd --config .jscpd.json --no-colors --no-tips",
    "impact": "node tools/impact-check.js",
    "dev:save": "node tools/dev-save.js",
    "check:bundles": "node tools/build-publish-bundles.js --check",
    "check:playwright": "node tools/check-playwright.js",
    "playwright:install": "node tools/install-playwright-chromium.js",
    "playwright:install:deps": "playwright install-deps chromium",
    "check:toolchain": "node tools/check-original-toolchain.js && node tools/check-playwright.js",
    "build:bundles": "node tools/build-publish-bundles.js",
    "build:publish": "npm run build:bundles && npm run check:bundles",
    "qa:install": "npm run check:toolchain",
    "test:original:list": "node tools/run-qa.js list",
    "test:original:focus": "node tools/run-qa.js focus",
    "test:original:logic": "node tools/run-qa.js logic",
    "test:original:browser:list": "node tools/run-browser-tests.js list",
    "test:original:browser:release": "node tools/run-browser-tests.js release",
    "test:original:browser:focus": "node tools/run-browser-tests.js focus",
    "test:original:preview": "node tools/run-browser-tests.js all",
    "test:list": "node tools/run-qa.js list",
    "test:focus": "node tools/run-qa.js focus",
    "test:contracts": "node tools/run-qa.js focus contracts",
    "test:storage": "node tools/run-qa.js focus storage",
    "test:progression": "node tools/run-qa.js focus progression",
    "test:battle": "node tools/run-qa.js focus battle",
    "test:characters": "node tools/run-qa.js focus characters",
    "test:presentation": "node tools/run-qa.js focus presentation",
    "test:determinism": "node tools/run-qa.js focus determinism",
    "test:all-relics": "node tools/test-all-relic-contracts.js",
    "test:save-fuzz": "node tools/test-save-fuzz.js",
    "test:soak": "node tools/run-battle-soak.js",
    "test:frames": "node tools/test-frame-performance.js",
    "test:logic": "node tools/run-qa.js logic",
    "test:browser:list": "node tools/run-browser-tests.js list",
    "test:browser:release": "node tools/run-browser-tests.js release",
    "test:browser:focus": "node tools/run-browser-tests.js focus",
    "test:preview": "node tools/run-browser-tests.js all",
    "test:a11y": "node tools/run-browser-tests.js focus accessibility",
    "test:offline": "bash scripts/test-offline.sh",
    "coverage:logic": "c8 node tools/run-qa.js logic",
    "analyze:coverage": "node tools/analyze-browser-coverage.js",
    "analyze:bundles": "node tools/analyze-bundles.js",
    "optimize:images": "node tools/optimize-images.js",
    "optimize:images:write": "node tools/optimize-images.js --write",
    "optimize:audio": "node tools/optimize-audio.js",
    "optimize:audio:write": "node tools/optimize-audio.js --write",
    "optimize:assets:write": "npm run optimize:images:write && npm run optimize:audio:write",
    "optimize:all": "npm run optimize:images && npm run optimize:audio && npm run analyze:coverage && npm run analyze:bundles && npm run test:frames && npm run check:duplicates",
    "replay:record": "node tools/battle-replay.js record",
    "replay:verify": "node tools/battle-replay.js verify",
    "qa:extended": "npm run qa:full && npm run coverage:logic && npm run test:soak && npm run optimize:all",
    "screenshot": "node tools/run-browser-tests.js focus smoke"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.45.0",
    "acorn": "^8.17.0",
    "ajv": "^8.20.0",
    "c8": "^12.0.0",
    "chokidar-cli": "^3.0.0",
    "eslint": "^10.6.0",
    "fast-check": "^4.9.0",
    "fast-uri": "https://registry.npmjs.org/fast-uri/-/fast-uri-3.1.4.tgz",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.7.0",
    "htmlhint": "^1.9.2",
    "jscpd": "^5.0.12",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.0",
    "terser": "^5.49.0"
  }
}
